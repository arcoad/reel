{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Reel",
  "version": "1.0.0",
  "identifier": "app.reel.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Reel",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU1OUVFQzc5ODU4QUJFNjMKUldSanZvcUZlZXllNWJQakJDMmYxTzNRcFV6TDRSK2ZHejJWRWxHcHFTVHVMeVRybERvTWpHbTYK",
      "endpoints": [
        "https://github.com/arcoad/reel/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
