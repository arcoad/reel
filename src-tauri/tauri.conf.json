{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VKX Desktop",
  "version": "0.1.5",
  "identifier": "dev.vkx.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "VKX Desktop",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU1OUVFQzc5ODU4QUJFNjMKUldSanZvcUZlZXllNWJQakJDMmYxTzNRcFV6TDRSK2ZHejJWRWxHcHFTVHVMeVRybERvTWpHbTYK",
      "endpoints": [
        "https://github.com/arcoad/vkx-desktop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}